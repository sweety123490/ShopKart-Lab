# ==============================================================================
# ShopKart Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to `.env` in the backend directory.
# 2. Fill in your actual credentials and keys.
# 3. NEVER commit your `.env` file to version control (Git).
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# MongoDB Connection String
# Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/shopkart
# Or MongoDB Atlas Cloud:
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shopkart?retryWrites=true&w=majority

# JSON Web Token (JWT) Secret Key
JWT_SECRET=your_jwt_super_secret_key_here

# Razorpay Payment Gateway Credentials (Test / Live)
# Obtain these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
